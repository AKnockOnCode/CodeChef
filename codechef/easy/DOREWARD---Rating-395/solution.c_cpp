#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int X;
        scanf("%d", & X);
        if (X < 4) {
            printf("BRONZE\n");
        }
        else if (X > 6) {
            printf("GOLD\n");
        }
        else {
            printf("SILVER\n");
        }
    }
    return 0;
}