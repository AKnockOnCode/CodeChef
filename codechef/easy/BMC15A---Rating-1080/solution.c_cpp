#include <stdio.h>

int gcd(int a, int b) {
    if (a == 0) {
        return b;
    }
    else if (b == 0) {
        return a;
    }
    else {
        gcd(b, a % b);
    }
}

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N, M;
        scanf("%d %d", & N, & M);
        printf("%d\n", gcd(N, M));
    }
    return 0;
}