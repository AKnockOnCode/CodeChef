#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int X, Y;
    scanf("%d %d", &X, &Y);
    if (X<Y){
        printf("FIRST\n");
    }
    else if (Y<X){
        printf("SECOND\n");
    }
    else{
        printf("ANY\n");
    }
    }
    return 0;
}