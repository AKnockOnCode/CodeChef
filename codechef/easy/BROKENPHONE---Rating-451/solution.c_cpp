#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int X, Y;
        scanf("%d %d", & X, & Y);
        if (X < Y) {
            printf("REPAIR\n");
        }
        else if (X == Y) {
            printf("ANY\n");
        }
        else {
            printf("NEW PHONE\n");
        }
    }
    return 0;
}