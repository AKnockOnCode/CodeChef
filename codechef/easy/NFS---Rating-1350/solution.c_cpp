#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int U, V, A, S;
    scanf("%d %d %d %d", &U, &V, &A, &S);
    int min = U * U - 2 * A * S;
    if (V*V>=min){
        printf("Yes\n");
    }
    else{
        printf("No\n");
    }
    }
    return 0;
}