#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int A, B, C;
    scanf("%d %d %d", &A, &B, &C);
    if (A<=B && A==C){
        printf("Yes\n");
    }
    else if (B==A && B<=C){
        printf("Yes\n");
    }
    else if (C<=A && C==B){
        printf("Yes\n");
    }
    else {
        printf("No\n");
    }
    }
    return 0;
}