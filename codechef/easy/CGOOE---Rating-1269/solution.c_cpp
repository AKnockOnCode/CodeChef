#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int j, count = 0, good = 1, flag = 0;
    for (i=1;i<N;i++){
        for (j=i-1;j>=0 && ++count <6;j--){
            if (arr[i]>=arr[j]){
                flag = 1;
                break;
            }
        }
        if (!flag){
            good++;
        }
        count = 0;
        flag = 0;
    }
    printf("%d\n", good);
    }
    return 0;
}