#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int A, B, C, D, E, F;
        scanf("%d %d %d %d %d %d", & A, & B, & C, & D, & E, & F);
        if ((A == C && B == D) || (A == D && B == C)) {
            printf("1\n");
        }
        else if ((A == E && B == F) || (A == F && B == E)) {
            printf("2\n");
        }
        else {
            printf("0\n");
        }
    }
    return 0;
}