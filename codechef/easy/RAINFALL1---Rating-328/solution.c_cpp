#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    if (N>6){
        printf("HEAVY\n");
    }
    else if (N>2){
        printf("MODERATE\n");
    }
    else{
        printf("LIGHT\n");
    }
    }
    return 0;
}