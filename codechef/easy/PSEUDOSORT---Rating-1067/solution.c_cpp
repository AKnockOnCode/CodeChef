#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N;
        scanf("%d", & N);
        int i;
        int arr[N];
        for (i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
        }
        int temp;
        for (i = 0; i < N - 1; i++) {
            if (arr[i] > arr[i + 1]) {
                temp = arr[i];
                arr[i] = arr[i + 1];
                arr[i + 1] = temp;
                break;
            }
        }
        int check = 0;
        for (i = 0; i < N - 1; i++)
        {
            if (arr[i] > arr[i + 1]) check++;
        }
        if (!check) printf("Yes\n");
        else printf("No\n");
    }
    return 0;
}