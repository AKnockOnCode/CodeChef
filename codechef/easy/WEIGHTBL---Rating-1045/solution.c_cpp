#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int a, b, c, d, e;
    scanf("%d %d %d %d %d", &a, &b, &c, &d, &e);
    int change = b-a;
    if (change<=d*e && change>=c*e){
        printf("1\n");
    }
    else{
        printf("0\n");
    }
    }
    return 0;
}