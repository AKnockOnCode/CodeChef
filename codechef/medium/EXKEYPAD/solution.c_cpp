#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, D;
    scanf("%d %d", &N, &D);
    int num, digits= 0, found = 1;
    while (found){
        found = 0;
        num = N++;
    while (num){
    if (num%10==D)found = 1;
        num /= 10;
    }
    }
    printf("%d\n", N-1);
    }
    return 0;
}