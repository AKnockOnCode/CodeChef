#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, D;
    scanf("%d %d", &N, &D);
    int num=N, digits= 0, place = 1;
    while (num){
        if (num%10==D){
            N = ((N/place)+1)*place;
            num = N;
            place = 1;
        }
        else{
        num /= 10;
        place *= 10;
    }}
    printf("%d\n", N);
    }
    return 0;
}