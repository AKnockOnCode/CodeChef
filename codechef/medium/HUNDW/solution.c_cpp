#include <stdio.h>
#include <stdlib.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int M, X, Y;
    scanf("%d %d %d", &M, &X, &Y);
    int i, j;
    int arr[M];
    for (i=0;i<M;i++){
        scanf("%d", &arr[i]);
    }
    int count = 0;
    for (i=1;i<=100;i++){
        for (j=0;j<M;j++){
        if (abs(i-arr[j]) <= X*Y){
            count++;
            break;
        }}
    }
    printf("%d\n", 100-count);
    }
    return 0;
}