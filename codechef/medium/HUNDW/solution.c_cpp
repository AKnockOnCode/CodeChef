#include <stdio.h>
#include <stdlib.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int M, X, Y;
    scanf("%d %d %d", &M, &X, &Y);
    int i;
    int arr[M];
    for (i=0;i<M;i++){
        scanf("%d", &arr[i]);
    }
    int count = 0;
    for (i=1;i<=100;i++){
        if (abs(i-arr[i]) > X*Y){
            count++;
        }
    }
    printf("%d\n", count);
    }
    return 0;
}