#include <stdio.h>
int main() {
    int N, K;
    scanf("%d %d", &N, &K);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    long long wait = arr[K];
    for (i=0;i<K;i++){
        if (arr[i]<arr[K]){
            wait += arr[i];
        }
        else{
            wait +=arr[K];
        }
    }
    for (i=K+1;i<N;i++){
        if (arr[i]<arr[K]){
            wait +=arr[i];
        }
        else {
            wait += arr[i]-K;
        }
    }
    printf("%lld\n", wait);
    return 0;
}