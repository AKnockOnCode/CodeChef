#include <stdio.h>
void dec(int arr[], int N, int K){
    int i;
    for (i=0;i<N;i++){
        if (arr[i]>0){
            arr[i]--;
        }
    }
}

int sum(int arr[], int N, int count, int K){
    for (int i=0;i<N;i++){
        if (arr[i]){
            count++;
        }
        if (!(arr[K]-1)){
            count++;
            break;
        }
    }
    return count;
}
int main() {
    int N, K;
    scanf("%d %d", &N, &K);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int count = 0;
    int wait = 0;
    while (arr[K]){
        wait += sum(arr, N, count, K);
        dec(arr, N, K);
    }
    printf("%d\n", wait);
    return 0;
}