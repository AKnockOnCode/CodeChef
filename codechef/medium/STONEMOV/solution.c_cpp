#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i, j;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int X;
    int count = 0;
    for (i = 0; i < N; i++){
        X = arr[i] < N - i - 1 ? arr[i] : N - i - 1;
        for (j = i + 1; j < N; j++){
            if (arr[i]--){
                arr[j]++;
                count++;
            }
        }
    }
    printf("%d\n", count);
    }
    return 0;
}