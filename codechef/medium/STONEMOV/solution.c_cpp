#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
        int N;
        scanf("%d", &N);
        long long arr[N];
        long long diff[N + 1];
        for (int i = 0; i <= N; i++) {
            diff[i] = 0;
        }
        for (int i = 0; i < N; i++) {
            scanf("%lld", &arr[i]);
        }
        long long count = 0;
        long long received = 0;
        for (int i = 0; i < N; i++) {
            received += diff[i];
            long long current = arr[i] + received;
            long long max_allowed = N - i - 1;
            long long X = current < max_allowed ? current : max_allowed;
            count += X;
            if (X > 0) {
                diff[i + 1] += 1;
                diff[i + 1 + X] -= 1;
            }
        }
        printf("%lld\n", count);
    }
    return 0;
}