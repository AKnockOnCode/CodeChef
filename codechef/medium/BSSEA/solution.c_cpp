#include <stdio.h>
#include <limits.h>
int main() {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    if (N==1){
        printf("%d\n", arr[0]);
    }
    else{
    double avg = (double)(arr[0] + arr[N-1]) / 2;
    int min = 0, max = INT_MAX;
    for (i=0;i<N;i++){
        if (arr[i] <= avg){
            if (arr[i]>min){
            min = arr[i];
        }
            
        }
        if (arr[i]>=avg){
            if (arr[i]<max){
                max = arr[i];
            }
        }
    }
    int result = (avg-min)<=(max-avg)?min:max;
    printf("%d\n", result);
    }
    return 0;
}