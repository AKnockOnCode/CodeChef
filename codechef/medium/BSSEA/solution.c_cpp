#include <stdio.h>
#include <limits.h>
int main() {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    if (N==1){
        printf("%d\n", arr[0]);
    }
    else{
         int min = INT_MAX, max = INT_MIN;
         for (i=0;i<N;i++){
             if (arr[i]>max){
                 max = arr[i];
             }
             if (arr[i]<min){
                 min = arr[i];
             }
         }
         
    double avg = (double)(min + max) / 2;
   
    for (i=0;i<N;i++){
        if (arr[i] <= avg){
            if (arr[i]>min){
            min = arr[i];
        }
            
        }
        if (arr[i]>=avg){
            if (arr[i]<max){
                max = arr[i];
            }
        }
    }
    int result = (avg-min)<=(max-avg)?min:max;
    printf("%d\n", result);
    }
    return 0;
}