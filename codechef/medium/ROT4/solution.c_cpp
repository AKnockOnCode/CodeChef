#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N;
        scanf("%d", & N);
        char S[N + 1];
        scanf("%s", S);
        int count = 0;
        for (int i = 0; i < N; i++) {
            int tens = S[i] - '0';
            int ones = S[(i + 1) % N] - '0';
            int num = (tens * 10) + ones;
            if (num % 4 == 0) {
                count++;
            }
        }
        printf("%d\n", count);
    }
    return 0;
}