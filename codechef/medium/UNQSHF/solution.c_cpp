#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    char A[N+1], B[N+1];
    scanf("%s", A);
    scanf("%s", B);
    int count = 0;
    for (i=0;A[i]!='\0';i++){
        if (A[i]=='a'){
            count++;
        }
        if (B[i]=='a'){
            count++;
        }
    }
    if (count == N){
        printf("Yes\n");
    }
    else {
        printf("No\n");
    }
    }
    return 0;
}