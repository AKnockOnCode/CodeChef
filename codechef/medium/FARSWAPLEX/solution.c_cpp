#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int temp = 0;
    for (int j=0;j<N-1;j++){
    for (i=0;i<N-1;i++){
        if (abs(arr[i]-arr[i+1])>1 && arr[i+1]<arr[i]){
            temp = arr[i];
            arr[i]=arr[i+1];
            arr[i+1]=temp;
        }}
    }
    for (i=0;i<N;i++){
        printf("%d ", arr[i]);
    }
    printf("\n");
    }
    return 0;
}