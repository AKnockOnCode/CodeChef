#include <stdio.h>

int main() {
    char s[101];
    scanf("%s", s);
    int k;
    scanf("%d", &k);
    int i, j;
    int count = 0, max  = 0, temp = 0;
    int one = 0, zero  = 0;
    for (i=0;s[i]!='\0';i++){
        zero = 0;
        one = 0;
        temp = 0;
        for (j=i;s[j+1]!='\0';j+=2){
            if (s[j]=='0'){
                zero++;
            }
            else{
                one++;
            }
            if (s[j+1]=='0'){
                zero++;
            }
            else{
                one++;
            }
            if (abs(one-zero)/2<=k){
                temp = one+zero;
            }
            if (temp>max){
                max = temp;
            }
        }
    }
    printf("%d\n", max);
    return 0;
}