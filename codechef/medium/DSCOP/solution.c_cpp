#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        long long N;
        scanf("%lld", & N);
        int i;
        long long temp = N;
        int check = 0;
        int digits = 0;
        while (temp) {
            digits++;
            temp /= 10;
        }
        temp = N;
        int digit = digits;
        int limits = digits;
        int arr[digits];
        long long divisor = 1;
        for (int k = 0; k < digits - 1; k++) {
            divisor *= 10;
        }
        for (i = 0; i < limits; i++) {
            arr[i] = temp / divisor;
            temp %= divisor;
            divisor /= 10;
        }
        i = 0;
        int max = 0;
        while (i != digit - 1) {
            if (arr[i] > arr[i + 1]) {
                max = arr[i];
                break;
            }
            i++;
        }
        if (i == digit - 1) {
            max = arr[i];
        }
        int used = 0;
        int result = 0;
        for (i = 0; i < digit; i++) {
            if (arr[i] == max && !used) {
                used++;
                continue;
            }
            result = result * 10 + arr[i];
        }
        printf("%d\n", result);
    }
    return 0;
}