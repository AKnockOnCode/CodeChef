#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int digits = 0;
    int temp = N;
    while (temp){
        digits++;
        temp /= 10;
    }
    printf("%d\n", N/(digits*10));
    }
    return 0;
}