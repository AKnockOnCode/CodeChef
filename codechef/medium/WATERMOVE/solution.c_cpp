#include <stdio.h>
#include <stdlib.h>
int cmp(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, K;
    scanf("%d %d", &N, &K);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    qsort(arr, N, sizeof(int), cmp);
    i = 1;
    int sum = arr[0];
    while (i<N && K--){
        sum += arr[i++];
    }
    printf("%d\n", sum);
    }
    return 0;
}