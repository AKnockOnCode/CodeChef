#include <stdio.h>
#include <stdlib.h>
int cmp(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, K;
    scanf("%d %d", &N, &K);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    qsort(arr, N, sizeof(int), cmp);
    int min = 100;
    if (N==2){
        min = arr[1]+arr[0];
    }
    else {
        min = arr[1]+arr[0]>arr[N-1]?arr[1]+arr[0]:arr[N-1];
    }
    printf("%d\n", min);
    }
    return 0;
}