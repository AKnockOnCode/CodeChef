#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N, K;
        scanf("%d %d", & N, & K);
        int i;
        char arr[N + 1];
        scanf("%s", arr);
        int alarms = 0;
        for (i = N - 1; i >= 0; i--) {
            if (arr[i] == '1') {
                alarms++;
                i -= K;
            }
        }
        printf("%d\n", alarms);
    }
    return 0;
}