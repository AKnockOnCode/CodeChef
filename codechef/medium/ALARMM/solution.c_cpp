#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, K;
    scanf("%d %d", &N, &K);
    int i;
    char arr[N+1];
    scanf("%s", arr);
    int alarms = 0;
    int num = K, j;
    for (i = N - 1; i >= 0; i--){
        num = K + 1;
        j = i;
        if (arr[i]=='1'){|
        while (num-- && j >= 0){
            if (arr[j]==0){
            arr[j--] = '0';
        alarms++;
                
            }}
    }
    }
    printf("%d\n", alarms);
    }
    return 0;
}