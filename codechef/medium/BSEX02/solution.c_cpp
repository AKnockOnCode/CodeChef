#include <stdio.h>
#include <stdlib.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--){
        int N;
        scanf("%d", &N);
        int layer = 1;
        int sum = 0;
        int calc;
        for (int i = 1;i<=N;i++){
            calc = layer * (layer+1)/2;
            if(calc<=N){
                layer++;
            }
            else{
                break;
            }
        }
        printf("%d\n", layer-1);    
    }
    return 0;
}