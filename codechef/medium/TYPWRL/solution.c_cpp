#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, M;
    scanf("%d %d", &N, &M);
    int i, j;
    char S[N+1];
    scanf("%s", S);
    char L[M+1];
    scanf("%s", L);
    int max = 0, countl = 0, countr=0;
    int found = 0;
    for (i=0;S[i]!='\0';i++){
        for (j=0;L[j]!='\0';j++){
            if (S[i]==L[j]){
                countl++;
                found = 1;
                continue;
            }
        }
        if (countl>max){
            max = countl;
        }
        if (!found){
            countr++;
        }
        if (found){
            countr=0;
        }
        if (countr>max){
            max = countr;
        }
        found = 0;
    }
    printf("%d\n", max);
    }
    return 0;
}