#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int freq[200000]={0};
    for (i=0;i<N;i++){
        freq[arr[i]]++;
    }
    int max = 0;
    for (i=0;i<200000;i++){
        if (freq[i]>max){
            max = freq[i];
        }
    }
    printf("%d\n", max/2+max%2);
    }
    return 0;
}