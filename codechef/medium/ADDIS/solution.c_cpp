#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    long long arr[N];
    for (i=0;i<N;i++){
        scanf("%lld", &arr[i]);
    }
    long long freq[200000]={0};
    for (i=0;i<N;i++){
        freq[arr[i]]++;
    }
    long long max = 0;
    for (i=0;i<200000;i++){
        if (freq[i]>max){
            max = freq[i];
        }
    }
    printf("%lld\n", max/2+max%2);
    }
    return 0;
}