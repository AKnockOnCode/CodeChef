#include <stdio.h>
#include <stdlib.h>


int compare(const void *a, const void *b) {
    long long x = *(const long long *)a;
    long long y = *(const long long *)b;
    return (x > y) - (x < y);
}
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    long long arr[N];
    for (i=0;i<N;i++){
        scanf("%lld", &arr[i]);
    }
    
qsort(arr, N, sizeof(long long), compare);
int freq = 1;
int max = 0;
int num = 0;
    for (i=0;i<N;i++){
        if (num==arr[i]){
            freq++;
        }
        else{
            num = arr[i];
        }
        if (freq>max){
            max = freq;
        }
    }
    printf("%d\n", max/2+max%2);
    }
    return 0;
}