#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int max = 0, count = 0;
    for (i = 0; i < N - 1; i++){
        if (arr[i] + 1 == arr[i + 1]){
            count++;
        }
    }
    }
    return 0;
}