int findMaximumPairs(Solution *sol, char students[]) {
    int i = 0, count = 0;
    while (students[i+1]!='\0'){
        if ((students[i]=='x' && students[i+1]=='y') ||(students[i]=='y' && students[i+1]=='x')){
            count++;
            i += 2;
        }
        else{
            i++;
        }
    }
    return count;
}
