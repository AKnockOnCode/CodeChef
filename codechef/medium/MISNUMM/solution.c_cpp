#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int M;
    scanf("%d", &M);
    int barr[M];
    for (i=0;i<M;i++){
        scanf("%d", &barr[i]);
    }
    int found = 0;
    int hash[1001] = {0};
    for (i=0;i<M;i++){
        for(int j = 0;j<N;j++){
            if (barr[i]==arr[j]){
                found = 1;
            }
        }
        if (!found){
            hash[barr[i]]++;
        }
        found = 0;
    }
    for (i=0;i<1001;i++){
        if (hash[i]){
            printf("%d ", i);
        }
    }
    printf("\n");
    return 0;
}