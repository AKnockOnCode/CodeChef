#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int M;
    scanf("%d", &M);
    int barr[M];
    for (i=0;i<M;i++){
        scanf("%d", &barr[i]);
    }
    int found = 0;
    int hasha[10001] = {0};
    int hashb[10001] = {0};
    for (i=0;i<M;i++){
        hashb[barr[i]]++;
    }
    for (i = 0;i<N;i++){
        hasha[arr[i]]++;
    }
    int h = 0;
    for (i=0;i<10001;i++){
        if (hasha[i]<hashb[i]){
            h++;
            printf("%d ", i);
        }
    }
    if (!h){
        printf("-1\n");
    }
    printf("\n");
    return 0;
}