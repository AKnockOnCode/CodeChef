#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, M, K;
    scanf("%d %d %d", &N, &M, &K);
    int i;
    int arr[M];
    for (i=0;i<M;i++){
        scanf("%d", &arr[i]);
    }
    int j = 1;
    int found = 0;
    while(K){
        found = 0;
        for (i=0;i<M;i++){
            if (arr[i]==j){
                found = 1;
                j++;
                break;
                
            }
        }
        if (!found){
            printf("%d ", j++);
            K--;
        }
    }
    printf("\n");
    }
    return 0;
}