#include <stdio.h>

int main() {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int hash[100001] = {0};
    for (i = 0; i< N;i++){
        hash[arr[i]]++;
    }
    for (i=0;i<N;i++){
        if (hash[arr[i]]){
            printf("%d ", arr[i]);
            hash[arr[i]] = 0;
        }
    }
    printf("\n");
    return 0;
}