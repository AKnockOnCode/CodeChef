#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, D;
    scanf("%d %d", &N, &D);
    int i;
    int arr1[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr1[i]);
    }
    int arr2[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr2[i]);
    }
    int sum1 = 0, sum2 = 0, sum3 = 0;
    for (i = 0; i < N; i++){
        sum1 += arr1[i];
    }
    for (i = 0; i < N; i++){
        sum2 += arr2[i];
    }
    sum1 += D;
    sum2 += D;
    sum3 += 2 * D;
    for (i = 0; i < N; i++){
        sum3 += arr1[i] < arr2[i] ? arr1[i] : arr2[i];
    }
    int result = sum1 < sum2 ? (sum1 < sum3 ? sum1 : sum3) : (sum2 < sum3 ? sum2 : sum3);
    printf("%d\n", result);
    }
    return 0;
}