#include <stdio.h>
#include <stdlib.h>
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    char S[N+1];
    scanf("%s", S);
    int up = 0, right = 0;
    for (i=0;S[i]!='\0';i++){
        if (S[i]=='U'){
            up++;
        }
        else if(S[i]=='D'){
            up--;
        }
        else if (S[i]=='R'){
            right++;
        }
        else{
            right--;
        }
    }
    if (abs(up)==0 && abs(right)==2){
        printf("Yes\n");
    }
    else if (abs(up)==2 && abs(right)==0){
        printf("Yes\n");
    }
    else{
        printf("No\n");
    }
    }
    return 0;
}