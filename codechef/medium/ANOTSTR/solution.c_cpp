#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    char A[N+1], B[N+1];
    scanf("%s", A);
    scanf("%s", B);
    int counta = 0, countb = 0;
    for (i=0;A[i]!='\0';i++){
        if (A[i]=='1'){
            counta++;
        }
    }
    for (i=0;B[i]!='\0';i++){
        if (B[i]=='1'){
            countb++;
        }
    }
    if (counta==countb){
        printf("YES\n");
    }
    else{
        printf("NO\n");
    }
    }
    return 0;
}