#include <stdio.h>
#include <stdlib.h>
int gcd(int a, int b){
    if (a==0){
        return b;
    }
    if (b==0){
        return a;
    }
    gcd (b, a%b);
}
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i, j, count = 0;
    for (i=1;i<=N;i++){
        for (j=1;j<=N;j++){
            if (gcd(i, j)==abs(i-j)){
                count++;
            }
        }
    }
    printf("%d\n", count);
    }
    return 0;
}