#include <stdio.h>

#include <stdlib.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N;
        scanf("%d", & N);
        long long value = 0;
        int arr[N];
        for (int i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
            if (i < N - 2) {
                value += abs(arr[i]);
            }
        }
        value += arr[N - 1] - arr[N - 2];
        printf("%lld\n", value);
    }
    return 0;
}