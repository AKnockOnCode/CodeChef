#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i, value = 0;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
        if (i<N-2){
            value+=arr[i];
        }
    }
    value += arr[N-2] + arr[N-1];
    printf("%d\n", value);
    }
    return 0;
}