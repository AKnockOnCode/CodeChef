#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N, M;
        scanf("%d %d", & N, & M);
        int i = 0, j = 0;
        int arr[N];
        for (i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
        }
        int money = M;
        int sum = 0, max = 0;
        while (j < N) {
            if (M - arr[j] >= 0) {
                sum++;
                M -= arr[j++];
            }
            else{
                sum--;
                M += arr[i++];
            }
            if (sum > max) {
                max = sum;
            }
            if (M<0){
                
            }
        }
    printf("%d\n", max);
}
return 0;
}