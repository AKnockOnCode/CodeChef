#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N, M;
        scanf("%d %d", & N, & M);
        int i, j = 0;
        int arr[N];
        for (i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
        }
        i=0;
        int money = M;
        int sum = 0, max = 0;
        while (j < N) {
            if (M - arr[j] >= 0) {
                sum++;
                M -= arr[j++];
            }
            else if (sum>0){
                sum--;
                M += arr[i++];
            }
            else{
                j++;
                i++;
            }
            if (sum > max) {
                max = sum;
            }
            
        }
        printf("%d\n", max);
    }
    return 0;
}