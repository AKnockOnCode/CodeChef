#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N, M;
        scanf("%d %d", & N, & M);
        int i, j;
        int arr[N];
        for (i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
        }
        int money = M;
        int sum = 0, max = 0;
        while (j < N) {
            if (M - arr[j] >= 0) {
                sum++;
                M -= arr[j++];
            }
        
        if (sum > max) {
            max = sum;
        }
        sum = 0;
    }
    }
    printf("%d\n", max);
}
return 0;
}