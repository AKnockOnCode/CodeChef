#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, M;
    scanf("%d %d", &N, &M);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int sum = 0, max = 0;
    for (i=0;i<N;i++){
        while (M>0){
            if (M-arr[i]>=0){
            sum += arr[i];
            M -= arr[i];
        }
            else{
                break;
            }
        }
    }
    }
    return 0;
}