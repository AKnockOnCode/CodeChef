#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int a = N/2;
    int hash[200001]={0};
    for (i=0;i<N;i++){
        hash[arr[i]]++;
    }
    long long max = 0;
    for (i=200000;i>=0;i--){
        if (hash[i]){
            max += i*hash[i];
            a = a-hash[i];
            if (a==0)break;
            if (a<0){
                max = max + (a*hash[i])/hash[i];
                break;
            }
        }
    }
    long long min = 0;
    for (i=0;i<N;i++){
        min+=arr[i];
    }
    min -= max;
    long long maxsize = N/2;
    long long minsize= N-N/2;
    printf("%lld\n", max * minsize + min *maxsize);
    }
    return 0;
}