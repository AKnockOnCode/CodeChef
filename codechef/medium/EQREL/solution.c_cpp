#include <stdio.h>

int main() {
    int N;
    scanf("%d", & N);
    int i;
    int arr[N];
    for (i = 0; i < N; i++) {
        scanf("%d", & arr[i]);
    }
    int energy = 0;
    int min = arr[0];
    for (i = 0; i < N; i++) {
        if (arr[i] < min) {
            min = arr[i];
        }
    }
    for (i = 0; i < N; i++) {
        energy += arr[i] - min;
    }
    printf("%d\n", energy);
    return 0;
}