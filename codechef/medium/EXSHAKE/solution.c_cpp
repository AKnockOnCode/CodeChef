#include <stdio.h>
#include <stdlib.h>
int compare(const void *a, const void *b) {
    int x = *(const int *)a;
    int y = *(const int *)b;
    return (x > y) - (x < y); 
}
int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N, M;
    scanf("%d %d", &N, &M);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    qsort(arr, N, sizeof(int), compare);
    int sum = 0, group = 0;
    for (i=0;i<N;i++){
        sum += arr[i];
        if ((sum*(sum-1)/2)<=M){
            group++;
        }
        else{
            break;
        }
    }
    printf("%d\n", group);
    }
    return 0;
}