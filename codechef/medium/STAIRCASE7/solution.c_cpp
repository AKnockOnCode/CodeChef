#include <stdio.h>

int hash[400005];

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    for (i=0;i<N;i++){
        hash[N+arr[i]-i]++;
    }
    int max = 0;
    for (i=0;i<=2*N;i++){
        if (hash[i]>max){
            max = hash[i];
        }
    }
    printf("%d\n", N - max);
    for (i = 0; i < N; i++) {
            hash[N + arr[i] - i] = 0;
        }
    }
    return 0;
}