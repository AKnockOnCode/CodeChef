#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int hash[200001]={0};
    for (i=0;i<N;i++){
        hash[N+arr[i]-i]++;
    }
    int max = 0;
    for (i=0;i<200001;i++){
        if (hash[i]>max){
            max = hash[i];
        }
    }
    printf("%d\n", N - max);
    }
    return 0;
}