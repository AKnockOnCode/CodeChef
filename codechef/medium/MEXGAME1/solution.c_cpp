#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);
    while (T--) {
    int N;
    scanf("%d", &N);
    int i;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int min = 101;
    int hash[102]={0};
    for (i=0;i<N;i++){
        hash[arr[i]]++;
    }
    for (i=0;i<102;i++){
        if (!hash[i]){
            min = i;
            break;
        }
    }
    int sum = 0;
    for (i=0;i<N;i++){
        if (arr[i]>min){
            sum += arr[i] - min;
        }
    }
    if (sum%2){
        printf("Alice\n");
    }
    else{
        printf("Bob\n");
    }
    }
    return 0;
}