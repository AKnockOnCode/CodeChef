#include <stdio.h>

int main() {
    int S;
    scanf("%d", &S);
    int i;
    int N = 2 * S;
    int arr[N];
    for (i=0;i<N;i++){
        scanf("%d", &arr[i]);
    }
    int count = 0;
    for (i=0;i<N-1;i++){
        if ((arr[i]^1)!=arr[i+1]){
            count++;
        }
    }
    printf("%d\n", count/2);
    return 0;
}