#include <stdio.h>

int main() {
    int T;
    scanf("%d", & T);
    while (T--) {
        int N;
        scanf("%d", & N);
        int i;
        int arr[N];
        for (i = 0; i < N; i++) {
            scanf("%d", & arr[i]);
        }
        int min = 100;
        int sum = 0;
        for (i = 0; i < N; i++) {
            if (arr[i] < min) {
                min = arr[i];
            }
        }
        for (i = 0; i < N; i++) {
            sum += arr[i];
        }
        sum -= min;
        printf("%d\n", sum);
    }
    return 0;
}